# Copy into your host environment, or into Streamlit Cloud -> App settings -> Secrets (TOML).
# Same keys also work in TOML form, for example: AIRAS_SMTP_HOST = "smtp.gmail.com"
# Do not commit real secrets.

# --- Allowed login emails (use on cloud if you do not commit faculty_allowlist.txt) ---
# AIRAS_ALLOWED_EMAILS="faculty1@school.edu,faculty2@school.edu"

# --- Email verification (optional) ---
# AIRAS_SMTP_HOST=smtp.gmail.com
# AIRAS_SMTP_PORT=587
# AIRAS_SMTP_USER=your@gmail.com
# AIRAS_SMTP_PASSWORD=app-password
# AIRAS_SMTP_FROM=your@gmail.com
# AIRAS_SMTP_USE_TLS=1
# Local dev: print codes to terminal instead of SMTP
# AIRAS_EMAIL_DEBUG=1

# --- Extra registration gate (optional) ---
# AIRAS_REGISTRATION_SECRET=long-random-string

# --- Dev only: disable allowlist (never in production) ---
# AIRAS_BYPASS_FACULTY_ALLOWLIST=1

# --- App storage (optional) ---
# Use a persistent volume path in production so app.db and allowlist survive restarts.
# AIRAS_DATA_DIR=/data
